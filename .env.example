# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps and Places Address Auto-Detection.
# Configured via AI Studio Secrets or Google Maps setup.
VITE_GOOGLE_MAPS_API_KEY="AIzaSy..."

# JAZZCASH MERCHANT GATEWAY (Like Daraz Direct Debit)
# Obtain from JazzCash Developer Portal: https://sandbox.jazzcash.com.pk/
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGERITY_SALT=""
JAZZCASH_ENVIRONMENT="sandbox" # or "production"

# EASYPAISA MERCHANT GATEWAY
# Obtain from Telenor Easypaisa Developer Portal
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_ACCOUNT_NUM=""
EASYPAISA_ENVIRONMENT="sandbox" # or "production"
